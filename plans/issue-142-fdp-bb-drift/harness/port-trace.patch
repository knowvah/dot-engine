diff --git a/src/layout/fdp/tr142.ts b/src/layout/fdp/tr142.ts
new file mode 100644
index 00000000..0b2bf8b3
--- /dev/null
+++ b/src/layout/fdp/tr142.ts
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: EPL-2.0
+// TEMPORARY issue #142 trace helper (never committed): %a-formatted traces
+// through globalThis.__tr142, set by harness/port-trace.ts.
+
+const view = new DataView(new ArrayBuffer(8));
+
+/** C printf("%a") for a double. */
+export function hx(x: number): string {
+  if (Number.isNaN(x)) return 'nan';
+  if (!Number.isFinite(x)) return x < 0 ? '-inf' : 'inf';
+  view.setFloat64(0, x);
+  const hi = view.getUint32(0);
+  const lo = view.getUint32(4);
+  const sign = hi >>> 31 ? '-' : '';
+  const exp = (hi >>> 20) & 0x7ff;
+  const mant = (BigInt(hi & 0xfffff) << 32n) | BigInt(lo);
+  if (exp === 0 && mant === 0n) return `${sign}0x0p+0`;
+  let frac = mant.toString(16).padStart(13, '0').replace(/0+$/, '');
+  if (frac) frac = `.${frac}`;
+  const lead = exp === 0 ? '0' : '1';
+  const e = exp === 0 ? -1022 : exp - 1023;
+  return `${sign}0x${lead}${frac}p${e < 0 ? '-' : '+'}${Math.abs(e)}`;
+}
+
+type Sink = (line: string) => void;
+const sink = (): Sink | undefined =>
+  (globalThis as { __tr142?: Sink }).__tr142;
+
+export const TR_ON = (): boolean => sink() !== undefined;
+export function TR(line: string): void {
+  sink()?.(line);
+}
+
+type Hooks = { __libm142?: Map<string, number>; __libmdiff142?: string[] };
+
+/**
+ * A libm call, traced as C's `libm <fn> <args> = <result>`. Counterfactual:
+ * when harness/port-trace.ts loaded a native trace, the result is native's
+ * for bit-equal arguments (a miss is traced as `cf.miss` and uses V8).
+ */
+export function lm142(fn: 'atan2' | 'cos' | 'sin', a: number, b?: number): number {
+  const key = b === undefined ? `${fn} ${hx(a)}` : `${fn} ${hx(a)} ${hx(b)}`;
+  const hooks = globalThis as Hooks;
+  const v8 = fn === 'atan2' ? Math.atan2(a, b!) : fn === 'cos' ? Math.cos(a) : Math.sin(a);
+  const hit = hooks.__libm142?.get(key);
+  if (hooks.__libm142 && hit === undefined) TR(`cf.miss ${key}`);
+  if (hit !== undefined && hit !== v8) hooks.__libmdiff142?.push(`${key} native=${hx(hit)} v8=${hx(v8)}`);
+  const r = hit ?? v8;
+  TR(`libm ${key} = ${hx(r)}`);
+  return r;
+}
