+/**
+ * Declare a node attribute with an empty default, as `agattr_text(g, AGNODE,
+ * name, "")` does. An existing root definition has its default reset to "",
+ * and stays printed (write.c prints a declared default even when empty); with
+ * none, the port's convention for an empty default is a missing key, so
+ * nothing is stored. Subgraph definitions are local symbols and keep theirs.
+ * @see lib/cgraph/attr.c:setattr (update old local definition)
+ */
+function declareEmptyNodeAttr(g: Graph, name: string): void {
+  if (g.nodeDefaults.has(name)) g.nodeDefaults.set(name, '');
+}
+
+/**
+ * Write each node's rank, and from phase 2 its order, as node attributes when
+ * a `phase` stop ends the layout early.
+ * @see lib/dotgen/dotinit.c:attach_phase_attrs
+ */
+function attachPhaseAttrs(g: Graph, maxphase: number): void {
+  declareEmptyNodeAttr(g, 'rank');
+  declareEmptyNodeAttr(g, 'order');
+  for (const n of g.nodes.values()) {
+    // ITOS of calloc'd ints: an unset field is 0.
+    if (maxphase >= 1) ownAttrs(n).set('rank', String(n.info.rank ?? 0));
+    if (maxphase >= 2) ownAttrs(n).set('order', String(n.info.order ?? 0));
+  }
+}
