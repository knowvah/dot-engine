digraph {
	graph [bb="0,0,0,0",
		newrank=true,
		phase=1
	];
	node [label="\N"];
	subgraph cluster_a {
		graph [bb="0,0,0,0"];
		a1	[height=0.5,
			pos="0,0",
			rank=0,
			width=0.75];
		a2	[height=0.5,
			pos="0,0",
			rank=0,
			width=0.75];
	}
	subgraph cluster_b {
		graph [bb="0,0,0,0"];
		b1	[height=0.5,
			pos="0,0",
			rank=1,
			width=0.75];
	}
	a1 -> b1;
	a2 -> b1;
}
