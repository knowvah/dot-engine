--- a/src/common/edge-in-box.ts
+++ b/src/common/edge-in-box.ts
@@ -47,8 +47,29 @@ function overlapLabel(lp: TextlabelT, b: Box): boolean {
  */
 export function edgeHasDrawableContent(e: Edge, clip: Box): boolean {
   const i = e.info;
+  if ((globalThis as {CF_B?: boolean}).CF_B) return (i.spl !== undefined && boxOverlap(cfSplBb(i.spl), clip))
+    || (i.label !== undefined && overlapLabel(i.label, clip))
+    || (i.xlabel !== undefined && i.xlabel.set && overlapLabel(i.xlabel, clip));
   return i.spl !== undefined
     || (i.label !== undefined && i.label.set && overlapLabel(i.label, clip))
     || i.xlabel !== undefined
     || i.head_label !== undefined || i.tail_label !== undefined;
 }
+
+function cfSplBb(spl: NonNullable<Edge['info']['spl']>): Box {
+  const bb: Box = { ll: { ...spl.list[0]!.list[0]! }, ur: { ...spl.list[0]!.list[0]! } };
+  const ex = (p: { x: number; y: number }): void => {
+    bb.ll.x = Math.min(bb.ll.x, p.x); bb.ll.y = Math.min(bb.ll.y, p.y);
+    bb.ur.x = Math.max(bb.ur.x, p.x); bb.ur.y = Math.max(bb.ur.y, p.y);
+  };
+  for (const bz of spl.list) {
+    ex(bz.list[0]!);
+    for (let k = 1; k < bz.list.length; k += 3) {
+      ex({ x: (bz.list[k]!.x + bz.list[k + 1]!.x) / 2, y: (bz.list[k]!.y + bz.list[k + 1]!.y) / 2 });
+      ex(bz.list[k + 2]!);
+    }
+    if (bz.sflag) ex(bz.sp);
+    if (bz.eflag) ex(bz.ep);
+  }
+  return bb;
+}
