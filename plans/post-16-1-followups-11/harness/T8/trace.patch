+static void t8dump(graph_t *g, const char *tag) {
+  if (!getenv("T8TRACE")) return;
+  fprintf(stderr, "T8 dump %s\n", tag);
+  for (node_t *n = agfstnode(g); n; n = agnxtnode(g, n)) {
+    if (!AGDATA(n) || strcmp(AGDATA(n)->name, "Agnodeinfo_t")) { fprintf(stderr, "T8   %s unbound\n", agnameof(n)); continue; }
+    fprintf(stderr, "T8   %s r=%d o=%d mark=%d onst=%d t=%d ufs=%d ufp=%s rt=%d cl=%s in=%d out=%d fin=%d fout=%d oth=%d x=%g y=%g\n",
+      agnameof(n), ND_rank(n), ND_order(n), ND_mark(n), ND_onstack(n), ND_node_type(n), ND_UF_size(n), ND_UF_parent(n)?agnameof(ND_UF_parent(n)):"-", ND_ranktype(n), ND_clust(n)?agnameof(ND_clust(n)):"-",
+      t8_size(ND_in(n)), t8_size(ND_out(n)), t8_size(ND_flat_in(n)), t8_size(ND_flat_out(n)), t8_size(ND_other(n)), ND_coord(n).x, ND_coord(n).y);
+  }
+  t8dumpg(g, 0);
+}
