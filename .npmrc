# `@knowvah/theme` (the docs site's brand theme) is published to GitHub
# Packages only, and a scope can point at one registry, so every @knowvah
# package installs from there. The other @knowvah packages this repo uses are
# mirrored to GitHub Packages by their release workflows (this repo's too; see
# release.yml). package.json pins `publishConfig.registry` to npmjs so
# `npm publish` is not redirected by this line. Auth for npm.pkg.github.com
# comes from ~/.npmrc locally and from the workflow token in CI; never here.
@knowvah:registry=https://npm.pkg.github.com
#
# npm 12 refuses tarball-URL dependencies by default (allow-remote=none), and
# `root` only admits URLs the project root depends on directly. The one URL
# here is package.json's override pinning vitepress-plugin-dot's
# @knowvah/dot-engine peer copy to the npmjs tarball (GitHub Packages drops
# peerDependenciesMeta, which would otherwise make canvas a required native
# peer); that peer edge is transitive, so only `all` admits it. Lockfile
# integrity hashes still pin every tarball. release.yml installs npm@latest,
# so without this line its `npm ci` fails with EALLOWREMOTE.
allow-remote=all
