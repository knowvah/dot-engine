{
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG_MAX_WAIT_MS": "1800000"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node --version)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config --get:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)",
      "Bash(shellcheck:*)",
      "Bash(ast-grep:*)",
      "Bash(lizard:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod +x:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(command -v:*)",
      "Bash(~/.claude/hooks/quality-gate.sh:*)",
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "WebFetch",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__find_symbol",
      "mcp__serena__search_for_pattern",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__rename_symbol",
      "mcp__serena__find_referencing_symbols",
      "Bash(python3 scripts/*:*)",
      "Bash(git rm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(bash -n:*)",
      "Bash(node:*)",
      "Bash(npx tsx:*)",
      "Bash(bash test/golden/gates.sh:*)",
      "Bash(GVBINDIR=/tmp/ghl:*)",
      "Bash(PARITY_OUT=:*)",
      "Bash(BENCH_IDS=:*)",
      "Bash(BENCH_POOL=:*)",
      "Bash(~/git/graphviz/build/cmd/dot/dot:*)",
      "Bash(~/git/graphviz-15/build/cmd/dot/dot:*)",
      "Bash(git -c commit.gpgsign=false commit:*)",
      "Bash(git worktree:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rev-list:*)",
      "Bash(git apply:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(uptime)",
      "Bash(ps:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(python3:*)",
      "Bash(plantuml:*)",
      "Bash(rm -f test/corpus/parity-mission-probe.json:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/post-compact-context.md"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-turn-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-init.sh",
            "async": true
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-instructions-loaded.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard-bash.py",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/nudge-search-tool.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-complexity.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-frontmatter.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh StopFailure",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PermissionDenied",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostToolUseFailure",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh SubagentStop",
            "async": true
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-hook-event.sh PostModelSwitch",
            "async": true
          }
        ]
      }
    ]
  }
}
