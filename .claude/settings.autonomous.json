{
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "permissions": {
    "allow": [
      "Bash(npm *:*)",
      "Bash(npx *:*)",
      "Bash(node *:*)",
      "Bash(git *:*)",
      "Bash(docker *:*)",
      "Bash(docker-compose *:*)",
      "Bash(python3 *:*)",
      "Bash(psql *:*)",
      "Bash(cargo *:*)",
      "Bash(go *:*)",
      "Bash(dotnet *:*)",
      "Bash(pnpm *:*)",
      "Bash(uv run:*)",
      "Bash(uv pip install:*)",
      "Bash(pip install *:*)",
      "Bash(pytest:*)",
      "Bash(gh *:*)",
      "Bash(shellcheck:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir *:*)",
      "Bash(cp *:*)",
      "Bash(mv *:*)",
      "Bash(chmod *:*)",
      "Bash(find *:*)",
      "Bash(grep *:*)",
      "Bash(wc *:*)",
      "Bash(sort *:*)",
      "Bash(head *:*)",
      "Bash(tail *:*)",
      "Bash(diff *:*)",
      "Bash(openssl *:*)",
      "Bash(command -v:*)",
      "Bash(curl -s https://raw.githubusercontent.com/**:*)",
      "Bash(~/.claude/hooks/quality-gate.sh:*)",
      "Bash(GVBINDIR=*)",
      "Bash(ATTR_ORACLE_TIMEOUT_MS=*)",
      "Bash(ENGINE_TIMEOUT_MULT=*)",
      "Bash(ENGINE_TIMEOUT_FLOOR_MS=*)",
      "Bash(ENGINE_ORACLE_TIMEOUT_MS=*)",
      "Bash(JSON_CONCURRENCY=*)",
      "Bash(MAP_CONCURRENCY=*)",
      "Bash(ORACLE_CACHE=*)",
      "Bash(PARITY_OUT=*)",
      "Bash(SURVEY_CONCURRENCY=*)",
      "Bash(SURVEY_HEAVY_SLOTS=*)",
      "Bash(DYLD_LIBRARY_PATH=*)",
      "Bash(~/git/graphviz/build/cmd/dot/dot *:*)",
      "Bash(timeout *:*)",
      "Bash(clang *:*)",
      "Bash(shasum *:*)",
      "Bash(ps *:*)",
      "Bash(pgrep *:*)",
      "Bash(kill *:*)",
      "Bash(time *:*)",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Glob(**)",
      "Grep(**)",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__find_symbol",
      "mcp__serena__search_for_pattern",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__rename_symbol",
      "mcp__serena__find_referencing_symbols",
      "Bash(rsync *:*)",
      "Bash(otool *:*)",
      "Bash(cmake *:*)",
      "Bash(make *:*)",
      "Bash(sed *:*)",
      "Bash(cmp *:*)",
      "Bash(~/git/graphviz-15/build/cmd/dot/dot *:*)",
      "Bash(/opt/homebrew/bin/dot *:*)",
      "Bash(objdump *:*)",
      "Bash(DOT_BIN=*)",
      "Bash(CORPUS_ROOT=*)",
      "Bash(GRAPHVIZ_BUILD=*)",
      "Bash(BENCH_POOL=*)",
      "Bash(sh test/corpus/gen-headless-gvbindir.sh*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(npm publish:*)",
      "Bash(git tag:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-turn-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-init.sh",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat ~/.claude/post-compact-context.md"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '-- COMPACTING: re-read plans/graphviz-16.1-sync/README.md + plans/graphviz-16.1-sync/decision-journal.md from disk; verify open task commits --'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-complexity.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
