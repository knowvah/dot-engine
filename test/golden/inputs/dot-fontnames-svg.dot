// @knowvah/dot-engine reference input: fontnames=svg selects the SVG generic
// font family (and the svg_font_weight/style fields) instead of the native
// family, so Helvetica-Bold emits font-family="sans-Serif", not
// "Helvetica,sans-Serif". @see gvrender_core_svg.c:464
// engine: dot
// tolerance: deterministic
digraph G {
    fontnames="svg";
    a [label="Hi", fontname="Helvetica-Bold"];
    b [label="It", fontname="Courier-Oblique"];
    a -> b;
}
